new file mode 100644
index 0000000..8f373e6
--- /dev/null
+++ b/validation.py
@@ -0,0 +1,14 @@
+"""Shared validation helpers."""
+
+
+def _valid_email(addr: str) -> bool:
+    if not isinstance(addr, str):
+        return False
+    if addr.count("@") != 1:
+        return False
+    local, _, domain = addr.partition("@")
+    if not local or not domain:
+        return False
+    if "." not in domain:
+        return False
+    return True
