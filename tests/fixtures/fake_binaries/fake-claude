#!/usr/bin/env bash
# Fake `claude` binary for E2E tests.
# Protocol: see ./README.md
set -u

# --- collect prompt -----------------------------------------------------------
prompt=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--prompt)
      prompt="${2:-}"
      shift 2
      ;;
    --output-format|--effort|--max-turns|--allowed-tools|--permission-mode|--model)
      # Recognised but ignored — keep flag-arg pair in sync.
      shift 2
      ;;
    --version)
      echo "fake-claude 0.0.0"
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done
# If still no -p, drain any stdin as the prompt.
if [[ -z "$prompt" ]] && [[ ! -t 0 ]]; then
  prompt="$(cat)"
fi

# --- failure mode short-circuits ---------------------------------------------
case "${AUTODEV_FAKE_FAILURE_MODE:-}" in
  error_max_turns)
    printf '{"is_error":true,"subtype":"error_max_turns","result":"max turns reached"}\n'
    exit 1
    ;;
  empty_result)
    printf '{"result":""}\n'
    exit 0
    ;;
  timeout)
    sleep 30
    exit 0
    ;;
  nonzero_exit)
    echo "fake-claude: synthetic failure" >&2
    exit 3
    ;;
esac

# --- canned response lookup ---------------------------------------------------
hash=""
if command -v md5sum >/dev/null 2>&1; then
  hash="$(printf '%s' "$prompt" | md5sum | awk '{print $1}')"
elif command -v md5 >/dev/null 2>&1; then
  hash="$(printf '%s' "$prompt" | md5 -q)"
fi
canned="${AUTODEV_FAKE_RESPONSE_DIR:-}/response_${hash}.json"
if [[ -n "$hash" && -f "$canned" ]]; then
  cat "$canned"
  exit 0
fi

# --- default success ----------------------------------------------------------
printf '{"result":"[fake-claude] default","model":"claude-haiku","stop_reason":"end_turn","usage":{"input_tokens":100,"output_tokens":50}}\n'
exit 0
